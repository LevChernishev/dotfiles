{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.11.4",
  "schemes" : [
    {
      "if" : {
        "device" : {
          "category" : "mouse"
        }
      },
      "pointer" : {
        "disableAcceleration" : true
      },
      "scrolling" : {
        "acceleration" : {
          "vertical" : 1
        },
        "distance" : {
          "vertical" : 3
        },
        "reverse" : {
          "vertical" : true
        },
        "smoothed" : {
          "vertical" : {
            "enabled" : false
          }
        },
        "speed" : {
          "vertical" : 0
        }
      }
    }
  ]
}