-- =====================================================================
-- 🐘 Эталонный конфигурационный файл ~/.psqlrc
-- =====================================================================

-- 1. Скрываем лишний системный вывод при старте сессии
\set QUIET 1

-- 2. Информативный и цветной Prompt:
-- Формат: [пользователь]@[база_данных][символ_транзакции]
-- Зеленый цвет для БД, голубой для юзера, желтый/красный для статуса транзакции:
--   #  (суперпользователь)
--   >  (обычный пользователь)
--   *  (открытая активная транзакция)
--   !  (ошибка в транзакции)
\set PROMPT1 '%[%033[1;36m%]%n%[%033[0m%]@%[%033[1;32m%]%/%[%033[0m%]%R%[%033[1;33m%]%#%[%033[0m%] '
\set PROMPT2 '%[%033[1;36m%]%n%[%033[0m%]@%[%033[1;32m%]%/%[%033[0m%]%R%[%033[1;33m%]-#%[%033[0m%] '

-- 3. Отображение NULL значений (чтобы не путать пустую строку '' и NULL)
\pset null '¤'

-- 4. Красивые Unicode рамки таблиц
\pset linestyle 'unicode'
\pset border 2

-- 5. Автоматическое переключение в расширенный режим (\x)
-- Если таблица не помещается по ширине терминала, psql сам развернет строки в ключ-значение
\x auto

-- 6. Замер времени выполнения каждого запроса
\timing on

-- 7. Настройка автодополнения (Tab)
\set COMP_KEYWORD_CASE upper

-- 8. Управление историей команд
\set HISTCONTROL ignoredups
\set HISTSIZE 10000

-- Раздельная история для разных баз данных (очень удобно!)
\set HISTFILE ~/.psql_history- :DBNAME

-- 9. Полезные встроенные макросы-переменные (вызываются через :имя)

-- Быстрый просмотр активности сессий: :activity
\set activity 'SELECT pid, usename, client_addr, state, wait_event_type, wait_event, to_char(now() - query_start, \'HH24:MI:SS.MS\') AS duration, substring(query, 1, 60) AS query_preview FROM pg_stat_activity WHERE pid <> pg_backend_pid() ORDER BY query_start ASC;'

-- Быстрый просмотр блокировок: :locks
\set locks 'SELECT bl.pid AS blocked_pid, a.usename AS blocked_user, kl.pid AS blocking_pid, ka.usename AS blocking_user, a.query AS blocked_statement FROM pg_catalog.pg_locks bl JOIN pg_catalog.pg_stat_activity a ON a.pid = bl.pid JOIN pg_catalog.pg_locks kl ON kl.transactionid = bl.transactionid AND kl.pid != bl.pid JOIN pg_catalog.pg_stat_activity ka ON ka.pid = kl.pid WHERE NOT bl.granted;'

-- Топ-20 самых тяжелых таблиц по размеру: :tablesize
\set tablesize 'SELECT relname AS "Table", pg_size_pretty(pg_total_relation_size(relid)) AS "Total", pg_size_pretty(pg_relation_size(relid)) AS "Data", pg_size_pretty(pg_indexes_size(relid)) AS "Indexes" FROM pg_catalog.pg_statio_user_tables ORDER BY pg_total_relation_size(relid) DESC LIMIT 20;'

-- Размеры всех баз данных: :dbsize
\set dbsize 'SELECT datname AS "Database", pg_size_pretty(pg_database_size(datname)) AS "Size" FROM pg_database ORDER BY pg_database_size(datname) DESC;'

-- Возвращаем вывод после загрузки конфига
\unset QUIET
