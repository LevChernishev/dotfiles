#!/usr/bin/env bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance (100% Transparent, floating pills) #####
sketchybar --bar \
  position=top \
  height=32 \
  blur_radius=0 \
  color=0x00000000 \
  padding_left=10 \
  padding_right=10 \
  y_offset=0 \
  topmost=off

##### Default Properties #####
sketchybar --default \
  padding_left=3 \
  padding_right=3 \
  icon.font="FiraCode Nerd Font:Bold:13.0" \
  label.font="FiraCode Nerd Font:Medium:12.0" \
  icon.color=0xffcdd6f4 \
  label.color=0xffcdd6f4 \
  background.drawing=on \
  background.color=0xee181825 \
  background.border_color=0x22ffffff \
  background.border_width=1 \
  background.corner_radius=6 \
  background.height=24

##### AeroSpace Workspaces (1-9) #####
FOCUSED="$(aerospace list-workspaces --focused 2>/dev/null)"
[ -z "$FOCUSED" ] && FOCUSED="1"

for sid in 1 2 3 4 5 6 7 8 9; do
  if [ "$sid" = "$FOCUSED" ]; then
    BG_COLOR="0xffcba6f7"
    ICON_COLOR="0xff11111b"
    BORDER_WIDTH=0
  else
    BG_COLOR="0xee181825"
    ICON_COLOR="0xffcdd6f4"
    BORDER_WIDTH=1
  fi
  sketchybar --add item "space.$sid" left \
             --set "space.$sid" \
                   icon="$sid" \
                   icon.padding_left=8 \
                   icon.padding_right=8 \
                   label.drawing=off \
                   background.drawing=on \
                   background.color="$BG_COLOR" \
                   background.border_width="$BORDER_WIDTH" \
                   icon.color="$ICON_COLOR" \
                   click_script="aerospace workspace $sid"
done

##### Active Application Indicator #####
sketchybar --add item front_app left \
           --set front_app \
                 icon.font="FiraCode Nerd Font:Bold:13.0" \
                 icon.padding_left=8 \
                 icon.padding_right=4 \
                 label.padding_right=8 \
                 icon.color=0xffcba6f7 \
                 label.color=0xffcdd6f4 \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Spotify (PWA in Chrome) #####
sketchybar --add item spotify left \
           --set spotify \
                 icon="󰓇" \
                 icon.color=0xffa6e3a1 \
                 icon.padding_left=8 \
                 icon.padding_right=4 \
                 label.padding_right=8 \
                 label.color=0xffcdd6f4 \
                 drawing=off \
                 update_freq=5 \
                 click_script="osascript /Users/lev/.config/karabiner/scripts/spotify_chrome.scpt playpause; sleep 0.2; $PLUGIN_DIR/spotify.sh" \
                 script="$PLUGIN_DIR/spotify.sh"

##### Right Side Items (order: VPN -> Keyboard -> Volume -> Battery -> Clock) #####

# 1. Clock (far right)
sketchybar --add item clock right \
           --set clock \
                 update_freq=10 \
                 icon.padding_left=8 \
                 icon.padding_right=4 \
                 label.padding_right=8 \
                 icon.color=0xffcba6f7 \
                 script="$PLUGIN_DIR/clock.sh"

# 2. Battery
sketchybar --add item battery right \
           --set battery \
                 update_freq=60 \
                 icon.padding_left=8 \
                 icon.padding_right=4 \
                 label.padding_right=8 \
                 script="$PLUGIN_DIR/battery.sh" \
           --subscribe battery system_woke power_source_change

# 3. Volume
sketchybar --add item volume right \
           --set volume \
                 icon.padding_left=8 \
                 icon.padding_right=4 \
                 label.padding_right=8 \
                 script="$PLUGIN_DIR/volume.sh" \
                 click_script="$CONFIG_DIR/bin/get_volume toggle; $PLUGIN_DIR/volume.sh" \
           --subscribe volume volume_change

# 4. Keyboard Input Source (100% event-driven, zero polling)
sketchybar --add event input_change AppleSelectedInputSourcesChangedNotification

sketchybar --add item keyboard right \
           --set keyboard \
                 icon=" " \
                 label.font="FiraCode Nerd Font:Bold:12.0" \
                 icon.padding_left=8 \
                 icon.padding_right=4 \
                 label.padding_right=8 \
                 icon.color=0xfffab387 \
                 click_script="$PLUGIN_DIR/keyboard.sh toggle; sketchybar --update" \
                 script="$PLUGIN_DIR/keyboard.sh" \
           --subscribe keyboard input_change

# 5. VPN Status (Shadowrocket)
sketchybar --add item vpn right \
           --set vpn \
                 update_freq=10 \
                 icon.padding_left=8 \
                 icon.padding_right=4 \
                 label.padding_right=8 \
                 click_script="$PLUGIN_DIR/vpn.sh toggle; sketchybar --update" \
                 script="$PLUGIN_DIR/vpn.sh"

# 6. RAM Usage
sketchybar --add item ram right \
           --set ram \
                 icon="󰍛" \
                 icon.color="0xfff9e2af" \
                 icon.padding_left=8 \
                 icon.padding_right=4 \
                 label.padding_right=8

# 7. CPU Load
sketchybar --add item cpu right \
           --set cpu \
                 icon="" \
                 icon.color="0xff89dceb" \
                 icon.padding_left=8 \
                 icon.padding_right=4 \
                 label.padding_right=8 \
                 update_freq=5 \
                 script="$PLUGIN_DIR/cpu_ram.sh"

##### Update all #####
sketchybar --update
"$PLUGIN_DIR/space_windows.sh" &
