#!/usr/bin/env bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance (100% Transparent, floating pills) #####
sketchybar --bar \
  position=top \
  height=32 \
  blur_radius=0 \
  color=0x00000000 \
  padding_left=12 \
  padding_right=12 \
  y_offset=0

##### Default Properties #####
sketchybar --default \
  padding_left=3 \
  padding_right=3 \
  icon.font="FiraCode Nerd Font:Bold:13.0" \
  label.font="FiraCode Nerd Font:Medium:12.0" \
  icon.color=0xffcdd6f4 \
  label.color=0xffcdd6f4 \
  background.corner_radius=6 \
  background.height=24

##### AeroSpace Event #####
sketchybar --add event aerospace_workspace_change

##### Workspaces (1-9) - only active and non-empty are displayed #####
for sid in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add item "space.$sid" left \
             --subscribe "space.$sid" aerospace_workspace_change \
             --set "space.$sid" \
                   icon="$sid" \
                   icon.padding_left=9 \
                   icon.padding_right=9 \
                   label.drawing=off \
                   click_script="aerospace workspace $sid" \
                   script="$PLUGIN_DIR/aerospace.sh $sid"
done

##### Active App Name #####
sketchybar --add item front_app left \
           --set front_app \
                 icon.drawing=off \
                 label.color=0xffcdd6f4 \
                 label.font="FiraCode Nerd Font:SemiBold:13.0" \
                 background.drawing=on \
                 background.color=0x33000000 \
                 background.corner_radius=6 \
                 background.height=24 \
                 label.padding_left=8 \
                 label.padding_right=8 \
                 script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Update all #####
sketchybar --update
