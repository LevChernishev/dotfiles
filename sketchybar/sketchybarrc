#!/usr/bin/env bash

PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance (100% Transparent, floating pills) #####
sketchybar --bar \
  position=top \
  height=32 \
  blur_radius=0 \
  color=0x00000000 \
  padding_left=10 \
  padding_right=10 \
  y_offset=0 \
  topmost=window

##### Default Properties #####
sketchybar --default \
  padding_left=3 \
  padding_right=3 \
  icon.font="FiraCode Nerd Font:Bold:13.0" \
  label.font="FiraCode Nerd Font:Bold:12.0" \
  icon.color=0xffcdd6f4 \
  label.color=0xffcdd6f4 \
  background.corner_radius=6 \
  background.height=24

##### AeroSpace Event #####
sketchybar --add event aerospace_workspace_change

##### Workspaces (1-9) - only active and non-empty are displayed #####
for sid in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add item "space.$sid" left \
             --subscribe "space.$sid" aerospace_workspace_change \
             --set "space.$sid" \
                   icon="$sid" \
                   icon.padding_left=8 \
                   icon.padding_right=8 \
                   label.drawing=off \
                   click_script="aerospace workspace $sid" \
                   script="$PLUGIN_DIR/aerospace.sh $sid"
done

##### Input Language Indicator #####
sketchybar --add event input_change AppleSelectedInputSourcesChangedNotification

sketchybar --add item keyboard right \
           --set keyboard \
                 icon=" " \
                 icon.font="FiraCode Nerd Font:Bold:13.0" \
                 label.font="FiraCode Nerd Font:Bold:12.0" \
                 label.color=0xff11111b \
                 icon.color=0xff11111b \
                 background.drawing=on \
                 background.color=0xffcba6f7 \
                 background.corner_radius=6 \
                 background.height=24 \
                 icon.padding_left=8 \
                 icon.padding_right=4 \
                 label.padding_right=8 \
                 update_freq=1 \
                 click_script="$PLUGIN_DIR/keyboard.sh toggle" \
                 script="$PLUGIN_DIR/keyboard.sh" \
           --subscribe keyboard input_change

##### Update all #####
sketchybar --update
